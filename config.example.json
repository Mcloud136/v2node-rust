{
  "Log": {
    "Level": "info",
    "Output": "",
    "Access": "none",
    "Ansi": false
  },
  "Nodes": [
    {
      "ApiHost": "https://panel.example.com",
      "NodeID": 1,
      "ApiKey": "CHANGE_ME",
      "Timeout": 15,
      "RetryCount": 1
    }
  ],
  "PprofPort": 0,
  "Runtime": {
    "ConfigWatchIntervalSecs": 2,
    "PanelConnectTimeoutSecs": 10,
    "PanelRequestTimeoutSecs": 15,
    "PanelRetryCount": 1,
    "PanelRetryBackoffMs": 200,
    "PushIdempotency": false,
    "TrafficSpoolPath": "/var/lib/v2node-rust/traffic.spool",
    "DefaultPullIntervalSecs": 60,
    "DefaultPushIntervalSecs": 60,
    "WsHandshakeTimeoutSecs": 4,
    "VlessHandshakeTimeoutSecs": 10,
    "WsMaxHeaderBytes": 8192,
    "WsMaxMessageBytes": 1048576,
    "WsEarlyDataMaxBytes": 2048,
    "WsHeartbeatSecs": 0,
    "ConnectionIdleTimeoutSecs": 0,
    "MaxConnections": 4096,
    "ListenBacklog": 4096,
    "DrainTimeoutSecs": 10,
    "TcpConnectTimeoutSecs": 10,
    "AllowPrivateTargets": false,
    "UdpIdleTimeoutSecs": 60,
    "RelayBufferSize": 32768,
    "TlsHandshakeTimeoutSecs": 4,
    "TlsMinVersion": "1.2",
    "TlsMaxVersion": "1.3",
    "TlsAlpn": ["http/1.1"],
    "CertReloadIntervalSecs": 60
  },
  "Acme": {
    "DirectoryUrl": "https://acme-staging-v02.api.letsencrypt.org/directory",
    "Email": "node@example.com",
    "AccountDir": "/etc/v2node-rust/acme",
    "Http01Bind": "0.0.0.0:80",
    "RenewBeforeDays": 30,
    "RenewCheckIntervalSecs": 86400,
    "DnsProvider": "cloudflare",
    "DnsEnv": {
      "CLOUDFLARE_DNS_API_TOKEN": "REPLACE_WITH_CLOUDFLARE_TOKEN"
    },
    "DnsPropagationDelaySecs": 10,
    "CloudflareApiBase": "https://api.cloudflare.com/client/v4",
    "RootCert": ""
  }
}
